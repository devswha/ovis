@@ -0,0 +1,53 @@
+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+use super::*;
+
+fn down(pane: &mut Pane) {
+    pane.state = State::Down {
+        spec: spec(Role::Active),
+        reason: "disconnected".into(),
+        attempts: 1,
+        retry_at: Instant::now() + Duration::from_secs(10),
+    };
+}
+
+#[tokio::test]
+async fn under_the_policy_input_typed_while_the_wire_is_down_is_refused_with_a_notice() {
+    let (mut pane, _, _) = rig();
+    pane.set_discard_input_on_recovery(true);
+    down(&mut pane);
+    assert!(!pane.key(&key('x')));
+    pane.paste(b"typed blind");
+    assert_eq!(pane.input_backlog().0, 0);
+    assert!(pane.take_input_rejection().is_some());
+}
+
+#[tokio::test]
+async fn under_the_policy_nothing_typed_during_a_recovery_reaches_the_recovered_wire() {
+    let (mut pane, mut rx, mut accept) = rig();
+    pane.set_discard_input_on_recovery(true);
+    pane.want(Some(spec(Role::Active)));
+    let mut first = serve(&mut accept, true).await;
+    step_until_live(&mut pane, &mut rx).await;
+    paint(&mut pane, &mut rx, &mut first, b"ready").await;
+    drop(first);
+    while !matches!(pane.state, State::Down { .. }) {
+        step(&mut pane, &mut rx).await;
+    }
+    pane.key(&key('a'));
+    pane.fire_retry(Instant::now() + Duration::from_secs(5));
+    pane.key(&key('b'));
+    let mut second = serve(&mut accept, true).await;
+    step_until_live(&mut pane, &mut rx).await;
+    pane.key(&key('c'));
+    paint(&mut pane, &mut rx, &mut second, b"back").await;
+    pane.key(&key('d'));
+    assert_eq!(read_kind(&mut second, CH, Kind::Data).await.payload, b"d");
+}
+
+#[tokio::test]
+async fn without_the_policy_a_key_typed_while_the_wire_is_down_still_queues() {
+    let (mut pane, _, _) = rig();
+    down(&mut pane);
+    assert!(pane.key(&key('x')));
+    assert_eq!(pane.input_backlog().0, 1);
+}
