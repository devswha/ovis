+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+//! An embedder's policy for input typed while a wire recovers: refused
+//! with the usual notice instead of queued for the recovered wire.
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use super::*;
+
+/// What `Pane::new` starts `discard_on_recovery` with.
+static DEFAULT: AtomicBool = AtomicBool::new(false);
+
+pub(in crate::app) fn default_discard_input_on_recovery(on: bool) {
+    DEFAULT.store(on, Ordering::Relaxed);
+}
+
+pub(super) fn default_policy() -> bool {
+    DEFAULT.load(Ordering::Relaxed)
+}
+
+impl Pane {
+    /// Under the policy: the wire is down, reopening after a loss, or
+    /// reopened and not painted yet. Input typed now would land on a
+    /// screen the user has not seen.
+    pub(super) fn refuses_recovery_input(&self) -> bool {
+        self.discard_on_recovery
+            && match &self.state {
+                State::Down { .. } => true,
+                State::Opening { resumed, .. } => *resumed,
+                State::Live(live) => live.resumed && live.await_paint,
+                State::Idle | State::Gone { .. } => false,
+            }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_discard_input_on_recovery(&mut self, on: bool) {
+        self.discard_on_recovery = on;
+    }
+}
