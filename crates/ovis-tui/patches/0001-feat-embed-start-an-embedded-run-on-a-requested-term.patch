+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+use super::*;
+
+fn listed(address: &str, created_ms: u64) -> hc_proto::terminal::Terminal {
+    let mut term = crate::sidebar::fixture::term(address);
+    term.pid = Some(1);
+    term.created_ms = created_ms;
+    term.labels
+        .insert("herdr.space".into(), format!("space-{address}"));
+    term.labels.insert("herdr.tab".into(), "tab".into());
+    term
+}
+
+#[tokio::test]
+async fn a_first_focus_request_is_taken_when_a_publish_lists_the_terminal() {
+    let mut app = app_with(&["t1", "t2", "t3"]);
+    app.set_initial_focus("t3".into());
+    app.reconcile_published_view();
+    assert_eq!(app.focused.as_deref(), Some("t3"));
+}
+
+#[tokio::test]
+async fn a_first_focus_request_is_taken_once() {
+    let mut app = app_with(&["t1", "t2"]);
+    app.set_initial_focus("t2".into());
+    app.reconcile_published_view();
+    app.focused = Some("t1".into());
+    app.reconcile_published_view();
+    assert_eq!(app.focused.as_deref(), Some("t1"));
+}
+
+#[tokio::test]
+async fn a_first_focus_request_waits_for_a_terminal_that_is_not_listed_yet() {
+    let mut app = app_with(&["t1"]);
+    app.set_initial_focus("t9".into());
+    app.reconcile_published_view();
+    assert_eq!(app.focused.as_deref(), Some("t1"));
+    app.view
+        .inventory
+        .replace(2, vec![listed("t1", 0), listed("t9", 9)]);
+    app.reconcile_published_view();
+    assert_eq!(app.focused.as_deref(), Some("t9"));
+}
