@@ -0,0 +1,24 @@
+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+//! An embedding program's requests: where the run starts (`crate::embed::Embed`).
+use super::*;
+
+impl App {
+    /// Focus `terminal` once the inventory first lists it.
+    pub fn set_initial_focus(&mut self, terminal: String) {
+        self.initial_focus = Some(terminal);
+    }
+
+    /// The first focus request, taken once: the same path as a
+    /// pane-row click, persisted like one.
+    pub(super) fn take_initial_focus(&mut self) {
+        let listed = self
+            .initial_focus
+            .as_ref()
+            .is_some_and(|wanted| self.view.inventory.get(wanted).is_some());
+        if listed && let Some(terminal) = self.initial_focus.take() {
+            self.focused = Some(terminal);
+            self.refresh_projection();
+            self.persist_focus();
+        }
+    }
+}
