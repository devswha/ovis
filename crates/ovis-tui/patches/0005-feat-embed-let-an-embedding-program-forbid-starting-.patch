     async fn a_remote_endpoint_never_starts_a_local_core() {
         let remote = Endpoint::Remote(Remote {
diff --git a/crates/hc-tui/src/embed.rs b/crates/hc-tui/src/embed.rs
index b127eac..a343ad1 100644
--- a/crates/hc-tui/src/embed.rs
+++ b/crates/hc-tui/src/embed.rs
@@ -11,4 +11,7 @@ pub struct Embed {
     /// terminal of a split tab alone, as a zoom does. Local to this
