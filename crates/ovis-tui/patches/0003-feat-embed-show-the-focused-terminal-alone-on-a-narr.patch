+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+use super::*;
+
+fn split_tab(solo: bool) -> App {
+    let mut app = app_with_spaces(&[("t1", "work"), ("t2", "work")]);
+    app.open_attach = Arc::new(|_| Box::pin(std::future::pending()));
+    app.pane = pane::Pane::new(app.pane_tx.clone(), app.open_attach.clone());
+    app.set_solo_on_narrow(solo);
+    app.focused = Some("t2".into());
+    app.refresh_projection();
+    app
+}
+
+/// One frame at `width`, past the frame cap, and the panes it shows.
+fn drawn_at(app: &mut App, width: u16) -> Vec<String> {
+    let now = Instant::now();
+    app.sched.mark_dirty(now);
+    app.sched.force_due(now);
+    let mut term = Terminal::new(TestBackend::new(width, 24)).unwrap();
+    app.maybe_draw(&mut term, now).unwrap();
+    app.visible_panes()
+}
+
+#[tokio::test]
+async fn a_narrow_screen_shows_the_focused_terminal_of_a_split_alone() {
+    let mut app = split_tab(true);
+    assert_eq!(drawn_at(&mut app, 50), ["t2"]);
+    let surface = ratatui::layout::Rect::new(0, 0, 50, 22);
+    let infos = super::super::pane_geometry::pane_infos(&app, surface);
+    assert_eq!(infos.len(), 1);
+    assert_eq!(infos[0].rect, surface);
+}
+
+#[tokio::test]
+async fn the_solo_pane_follows_the_focus_and_ends_on_a_wide_screen() {
+    let mut app = split_tab(true);
+    assert_eq!(drawn_at(&mut app, 64), ["t2"]);
+    app.focused = Some("t1".into());
+    app.refresh_projection();
+    assert_eq!(app.visible_panes(), ["t1"]);
+    assert_eq!(drawn_at(&mut app, 65), ["t1", "t2"]);
+    assert_eq!(drawn_at(&mut app, 40), ["t1"]);
+}
+
+#[tokio::test]
+async fn the_solo_pane_is_local_and_asks_for_no_layout_edit() {
+    let mut app = split_tab(true);
+    drawn_at(&mut app, 50);
+    // an edit asked for here, with no store to take it, would leave its notice
+    assert!(app.notice.is_none());
+    assert!(app.projection.snapshot.tabs.iter().all(|tab| !tab.zoomed));
+}
+
+#[tokio::test]
+async fn without_the_setting_a_narrow_screen_keeps_its_split() {
+    let mut app = split_tab(false);
+    assert_eq!(drawn_at(&mut app, 50), ["t1", "t2"]);
+}
