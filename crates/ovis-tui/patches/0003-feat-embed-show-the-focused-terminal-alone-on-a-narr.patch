diff --git a/crates/hc-tui/src/app/embed.rs b/crates/hc-tui/src/app/embed.rs
index 34fcd20..99ad35b 100644
--- a/crates/hc-tui/src/app/embed.rs
+++ b/crates/hc-tui/src/app/embed.rs
@@ -1,6 +1,6 @@
 // Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
 //! An embedding program's requests: what happens to input typed during
-//! a recovery (`crate::embed::Embed`).
+//! a recovery, and what a narrow screen shows (`crate::embed::Embed`).
 use super::*;
 
 impl App {
@@ -8,4 +8,51 @@ impl App {
     pub fn discard_input_on_recovery(on: bool) {
         pane::default_discard_input_on_recovery(on);
     }
+
+    pub fn set_solo_on_narrow(&mut self, on: bool) {
+        self.solo_on_narrow = on;
+    }
+
+    fn wants_solo(&self) -> bool {
+        self.solo_on_narrow && self.area.0 <= self.shell.mobile_width_threshold
+    }
+
+    /// A narrow screen shows the focused tab's focused terminal alone:
+    /// this client's projection reads as zoomed on it. The document is
+    /// not touched, so no other client's view changes.
+    pub(super) fn apply_solo(&mut self) {
+        self.solo_applied = self.wants_solo();
+        if !self.solo_applied {
+            return;
+        }
+        let Some(tab) = self
+            .projection
+            .snapshot
+            .focused_tab_id
+            .as_ref()
+            .and_then(|id| self.projection.layouts.get_mut(id))
+        else {
+            return;
+        };
+        let members = tab
+            .root
+            .as_ref()
+            .map(|root| root.terminals())
+            .unwrap_or_default();
+        if tab.zoomed.is_none() && members.len() > 1 {
+            tab.zoomed = self
+                .focused
+                .clone()
+                .filter(|focused| members.contains(focused))
+                .or_else(|| tab.focused.clone());
+        }
+    }
+
+    /// The screen crossed the mobile width since the projection was
+    /// made: it is made again for the width in hand.
+    pub(super) fn keep_solo_current(&mut self) {
+        if self.solo_applied != self.wants_solo() {
+            self.refresh_projection();
+        }
+    }
 }
