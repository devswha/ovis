<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- the launcher asks it to draw the widget -->
        <receiver
            android:name=".InboxWidget"
            android:label="@string/ovis_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ovis_inbox_widget" />
        </receiver>

        <!-- a digest from OvisMessagingService, which sends it to this app only -->
        <receiver
            android:name=".InboxReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="sh.ovis.push.INBOX" />
            </intent-filter>
        </receiver>

        <service
            android:name=".InboxRowsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- registers OvisWidgetPlugin with Capacitor's activity before its bridge starts -->
        <provider
            android:name=".OvisWidgetInitializer"
            android:authorities="${applicationId}.ovishomewidget"
            android:exported="false" />
    </application>
</manifest>
