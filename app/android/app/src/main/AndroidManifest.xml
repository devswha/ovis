<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleInstancePerTask"
            android:exported="true">

            <!-- each window is a task of its own, so split screen and free windows can show two;
                 this offers New window in the launcher and taskbar -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- the account service's sign-in comes back here (OvisAuthPlugin) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ovis" android:host="account" android:path="/callback" />
            </intent-filter>

            <!-- a PC's page on the hosted shell (a relay pairing link, or its QR code read by the
                 camera) opens in the app: verified against app.ovis.sh/.well-known/assetlinks.json
                 (scripts/shell-build.ts), and handed to the connect screen (MainActivity.takeAppLink) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.ovis.sh" android:pathPrefix="/s/" />
            </intent-filter>

        </activity>

        <!-- keeps a live call going out of sight or with the screen locked (LiveCallService.java) -->
        <service
            android:name=".LiveCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <!-- Fork: Android's digital assistant role, side-button session and shell-only control glow. -->
        <receiver android:name=".fork.assistant.control.ControlReceiver" android:exported="true"
            android:enabled="@bool/ovis_assistant_supported" android:permission="android.permission.DUMP" />
        <service android:name=".fork.assistant.session.AssistantService" android:exported="true"
            android:enabled="@bool/ovis_assistant_supported"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/ovis_assistant_service" />
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
        </service>
        <service android:name=".fork.assistant.session.AssistantSessionService" android:exported="true"
            android:enabled="@bool/ovis_assistant_supported"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".fork.assistant.session.AssistantRecognitionService" android:exported="true"
            android:enabled="@bool/ovis_assistant_supported">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>

        <!-- Add over SSH (OvisSshPlugin): not exported, only the app opens it. Its work runs on a thread that
             waits on its dialogs and returns its result to this instance, so a rotation or a theme or language
             change must not recreate it -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".SshSetupActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the page's microphone (dictation, live voice): Capacitor asks for both when it calls getUserMedia -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- a live call as Android's own phone call, which the lock screen shows (TelecomCall.java) -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
</manifest>
